FROM python:3.12-slim
WORKDIR /app
COPY lapi_backend/requirements.txt lapi_backend/requirements-models.txt lapi_backend/requirements-oracle.txt ./lapi_backend/
COPY lapi_testing/backend/requirements.txt ./lapi_testing/backend/
RUN pip install --no-cache-dir -r lapi_testing/backend/requirements.txt -r lapi_backend/requirements-oracle.txt
COPY lapi_backend/lapi_app ./lapi_backend/lapi_app
COPY lapi_testing/backend ./lapi_testing/backend
COPY lapi_testing/pytest.ini ./lapi_testing/
COPY lapi_testing/scripts/oracle_check.py lapi_testing/scripts/oracle_model_check.py ./lapi_testing/scripts/
COPY lapi_local_use/lapi_scripts/setup_oracle.py lapi_local_use/lapi_scripts/reset_admin_password.py ./lapi_local_use/lapi_scripts/
COPY lapi_local_use/.env.oracle.example ./lapi_local_use/
ENV PYTHONPATH=/app/lapi_backend PYTHONUNBUFFERED=1
CMD ["python", "lapi_testing/scripts/oracle_check.py"]
