# Generate .env.oracle and private password files with lapi_local_use/lapi_scripts/start-oracle.ps1
# or lapi_local_use/lapi_scripts/start-oracle.sh. Never copy a colleague's private configuration.
LAPI_MASTER_KEY=CHANGE_ME_MASTER_KEY
LAPI_PORT=3003
LAPI_BIND_ADDRESS=127.0.0.1
LAPI_PUBLIC_ORIGIN=http://localhost:3003
LAPI_ORACLE_SECRET_DIR=./secrets/oracle
ORACLE_IMAGE=container-registry.oracle.com/database/free:23.26.3.0
ORACLE_APP_USER=LAPI_OWNER
MODEL_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
LAPI_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text
LAPI_ALLOW_MOCK=false

# Stateful assistant; legacy is an explicit rollback switch.
LAPI_AGENT_ENGINE=langgraph

# Local vision OCR for scanned PDF pages and visible DOCX raster images.
LAPI_OCR_ENABLED=true
LAPI_OCR_MODEL=qwen2.5vl:3b
LAPI_OCR_TIMEOUT=1200
LAPI_OCR_CONTEXT=8192
LAPI_OCR_MAX_TOKENS=3000
LAPI_OCR_DPI=180
LAPI_OCR_BATCH=128
# False preserves automatic accessible GPU selection and CPU fallback.
LAPI_OCR_FORCE_CPU=false
